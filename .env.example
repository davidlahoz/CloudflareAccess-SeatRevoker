# cfseats configuration
#
# Copy and fill in:
#   server:  sudo sh deploy/install.sh   (installs this as /etc/cfseats/cfseats.env,
#                                         root:cfseats 0640, then: sudoedit /etc/cfseats/cfseats.env)
#   local:   cp .env.example .env  &&  python3 cfseats.py --env-file .env
#
# Format: KEY=VALUE, one per line, no inline comments.
# Never commit a filled-in copy; *.env and .env are gitignored.

# --- Required -----------------------------------------------------------------

# API token with permission to read Access users and update seats on the account.
CLOUDFLARE_API_TOKEN=

# 32-character hex account ID (dashboard URL or Account Home sidebar).
CF_ACCOUNT_ID=

# --- Optional -----------------------------------------------------------------

# Comma-separated emails that are never removed (case-insensitive).
# Example: CF_EXCLUDE=admin@example.com,ceo@example.com
CF_EXCLUDE=

# Remove any seat holder whose last login is at least this many hours ago.
CF_MAX_IDLE_HOURS=24

# Seat budget. After idle removals, if holders > CF_MAX_SEATS - CF_HEADROOM,
# the oldest remaining holders are also removed until at that target.
CF_MAX_SEATS=50
CF_HEADROOM=5

# Live mode only when this is exactly: false
# Any other value logs the plan and removes nothing.
CF_DRY_RUN=true